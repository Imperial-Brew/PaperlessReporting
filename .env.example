# PaperlessReporting Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
PAPERLESS_API_TOKEN=your_api_token_here
API_BASE_URL=https://api.paperlessparts.com

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_DEFAULT_REGION=us-east-2

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text  # Use 'json' for JSON-formatted logs
LOG_FILE=logs/application.log  # Optional: Path to log file (logs to console if not set)
