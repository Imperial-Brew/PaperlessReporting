# Auto-detect text files and normalize to LF in the repo
* text=auto eol=lf

# Force Python files to use LF in the repo
*.py text eol=lf

# Force shell scripts to use LF in the repo
*.sh text eol=lf

# Force JSON files to use LF in the repo
*.json text eol=lf

# Force YAML files to use LF in the repo
*.yml text eol=lf
*.yaml text eol=lf

# Force markdown files to use LF in the repo
*.md text eol=lf
